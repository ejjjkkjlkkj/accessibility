// Lecture du processeur (instruction CPUID) et des tables SMBIOS que le firmware a laissées en mémoire (table de configuration UEFI).
// Rien n'est écrit. Les numéros de série ne sont jamais affichés.

// Écrit les 4 octets (ASCII) d'un mot de 32 bits, du poids faible au poids fort ; s'arrête au zéro. Renvoie 0 si fin de chaîne atteinte.
fn mot_ascii(v: int) -> int {
    let i = 0;
    while i < 4 {
        let c = (v / pw8(i)) % 256;
        if c == 0 { return 0; }
        car(c);
        i = i + 1;
    }
    return 1;
}
fn pw8(i: int) -> int {
    let r = 1;
    while i > 0 { r = r * 256; i = i - 1; }
    return r;
}

// Nom commercial du processeur (feuilles 0x80000002 à 0x80000004).
fn cpu_nom() {
    let l = 2147483650;
    while l <= 2147483652 {
        mot_ascii(cpuid(l, 0));
        mot_ascii(cpuid(l, 1));
        mot_ascii(cpuid(l, 2));
        mot_ascii(cpuid(l, 3));
        l = l + 1;
    }
}

fn cpu_fabricant() {
    mot_ascii(cpuid(0, 1));
    mot_ascii(cpuid(0, 3));
    mot_ascii(cpuid(0, 2));
}

// Adresse du premier octet des tables SMBIOS (entrée SMBIOS 3 de la table de configuration UEFI), 0 si absente.
fn sm_debut() -> int {
    let st = systab();
    if st == 0 { return 0; }
    let n = peek(st + 104);
    let tab = peek(st + 112);
    let i = 0;
    while i < n {
        let e = tab + i * 24;
        if peek32(e) == 4076672324 {
            if peek32(e + 4) == 1244436372 {
                if peek32(e + 8) == 3152359065 {
                    if peek32(e + 12) == 2497913039 { return peek(peek(e + 16) + 16); }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// Adresse de la n-ième structure (à partir de 0) du type donné, 0 si absente.
fn sm_structure(typ: int, n: int) -> int {
    let p = sm_debut();
    if p == 0 { return 0; }
    let guard = 0;
    while guard < 400 {
        let t = peek8(p);
        if t == 127 { return 0; }
        let l = peek8(p + 1);
        if t == typ {
            if n == 0 { return p; }
            n = n - 1;
        }
        let q = p + l;
        while peek16(q) != 0 { q = q + 1; }
        p = q + 2;
        guard = guard + 1;
    }
    return 0;
}

// Écrit la chaîne numéro idx (à partir de 1) de la structure s.
fn sm_chaine(s: int, idx: int) {
    if idx == 0 { return; }
    let q = s + peek8(s + 1);
    while idx > 1 {
        while peek8(q) != 0 { q = q + 1; }
        q = q + 1;
        idx = idx - 1;
    }
    while peek8(q) != 0 { car(peek8(q)); q = q + 1; }
}
